function [all_combos] = find_entropy_thresholds(all_subjects, brain_region_names, cross_corrs, voxel_ref)

[~, strio_projecting_regions, matrix_projecting_regions,~,...
    ~] = load_striosome_projecting_rankings(strio_filename, brain_region_names);

br_names = brain_region_names{1,1};

is_mem_strio = ismember(br_names,  string(strio_projecting_regions));
strio_ids = find(is_mem_strio);

is_mem_matrix = ismember(br_names,  string(matrix_projecting_regions));
matrix_ids = find(is_mem_matrix);

dms_index = find(br_names=='left-caudate');

n_subj = length(all_subjects);
for subj=1:n_subj
    all_combos = [];

    striatum_voxels = voxel_ref{1,subj}{1,dms_index};
    n_thresh = 10;

    all_ids = [strio_ids;matrix_ids];
    % create all combinations of br thresholds
    for br = 1:length(all_ids)
        curr_br = br_ids(br);

        corr_matrix = cross_corrs{1,subj}{curr_br, dms_index};
        [br_thresholds] = get_thresh_range(corr_matrix,n_thresh);
        corr_matrices{br} = corr_matrix;
        all_br_thresholds{br} = br_thresholds;
    end

    combos = combinations(all_br_thresholds{1},all_br_thresholds{2},...
        all_br_thresholds{3}, all_br_thresholds{4},...
         all_br_thresholds{5}, all_br_thresholds{6});
    combos = renamevars(combos, {'Var1','Var2','Var3','Var4','Var5','Var6'},...
        {'br1_thresh','br2_thresh','br3_thresh','br4_thresh','br5_thresh','br6_thresh'});
  
    all_combos = [];
    for c = 1:height(combos)
        threshold_combo = combos(c,:);

        overlapped_vox = array2table(double.empty(0,3), 'VariableNames', {'x','y','z'});
        for n = 1:6
            corr_threshold_br = threshold_combo.('br' + string(n) + '_thresh');
            br_vox = get_vox(corr_matrices{n}, striatum_voxels, corr_threshold_br, string(n));
            overlapped_vox = outerjoin(overlapped_vox, br_vox, "MergeKeys", 1, "Keys", {'x','y','z'});
        end

        all_strio = overlapped_vox(overlapped_vox.strio_br1 ...
            & overlapped_vox.strio_br2 & overlapped_vox.strio_br3 ...
            & overlapped_vox.strio_br4 & , :);

        curr_row = cluster_strio_vox(all_strio);
        threshold_combo = [threshold_combo struct2table(curr_row)];
        threshold_combo.entropy = calculate_entropy(height(overlapped_vox), height(all_strio));
        all_combos = [all_combos; threshold_combo];

    end
end

end

function [shuffled_corrs, shuffled_vox] = shuffle_vox(corr_matrix, striatum_voxels)
    shuffled_idx = randperm(length(striatum_voxels));
    shuffled_corrs = corr_matrix(shuffled_idx, :);
    shuffled_vox = striatum_voxels(shuffled_idx);
 end

 function vox_table = get_vox(corr_matrix, striatum_voxels, corr_threshold, br_name)

% use the same method as in get_strio_vox to choose corrs to threshold
base_thresh = 3;
dms_thresh = 0;

hi_corr_vox = (corr_matrix > corr_threshold);

num_hi_cnx_base = sum(hi_corr_vox, 2);
hi_base_idx = find(num_hi_cnx_base > base_thresh);

% connections between striatal voxels only to those high likelihood LH vox
dms_to_high_base = hi_corr_vox(hi_base_idx,:);
num_hi_cnx_dms = sum(dms_to_high_base, 1);

strio_vox = num_hi_cnx_dms > dms_thresh;

vox_with_val = [striatum_voxels strio_vox'];
strio_name = char("strio_br" + br_name);
vox_table = array2table(vox_with_val,'VariableNames',{'x','y','z',strio_name});

end

function thresholds = get_thresh_range(corr_matrix,n)
    
    mean_corr = mean(corr_matrix, 'all', 'omitnan');
    std_corr = std(corr_matrix, 0, 'all','omitnan');
    min_corr = mean_corr + 2*std_corr;
    max_corr = max(corr_matrix, [], 'all');
    thresholds = linspace(min_corr, max_corr, n);

end

function curr_row = cluster_strio_vox(strio_table)

xVsYVsZ = [strio_table.x, strio_table.y, strio_table.z];
if ~isempty(xVsYVsZ)
    idx = dbscan(xVsYVsZ,1,1);
    obj_sum = get_sum_over_idx(idx);
else
    obj_sum = -1;
end

curr_row.num_vox = height(xVsYVsZ);
curr_row.obj_sum = obj_sum;

end

function tot_sum = get_sum_over_idx(idx)

idx_counts = groupcounts(idx);
tot_sum = 0;
for i = 1:length(idx_counts)
    count = idx_counts(i);
    tot_sum = tot_sum + (1/count);
end
end

function entropy = calculate_entropy(total_n, n_overlap_vox)

n_not_overlap = total_n - n_overlap_vox;
vals = [n_not_overlap / total_n ; n_overlap_vox / total_n];

entropy = 0;
for i = 1:length(vals)
    val = vals(i);
    entropy = entropy + val * log(val);
end

entropy = -entropy;
end