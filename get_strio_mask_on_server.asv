function get_strio_mask_on_server(subj_id, dms_name, dms_mask_filename, h, thresh)

subj_dir = "/sc/arion/projects/K01_VTA/users/rakocl01/" + subj_id + "/test";
voxel_dir = subj_dir + "/voxel_dir";
mask_dir = subj_dir + "/ROIs/native_oct25";
mkdir(mask_dir)

concat_txt_files(voxel_dir+"/"+subj_id+"_Area-p24ab.p24a_lh_MNI152_voxels.txt",...
    voxel_dir+"/"+subj_id+"_Area-p32_lh_MNI152_voxels.txt",voxel_dir+"/"+subj_id+"_a24_a32_lh_voxels")
concat_txt_files(voxel_dir+"/"+subj_id+"_Area-p24ab.p24a_rh_MNI152_voxels.txt",...
    voxel_dir+"/"+subj_id+"_Area-p32_rh_MNI152_voxels.txt",voxel_dir+"/"+subj_id+"_a24_a32_rh_voxels")

save_to = subj_dir + "_results_oct25/";
mkdir(save_to)
all_regions = ["a24_a32_lh"; "final_SN"; "Hb_mni" ; "a24_a32_rh"; "Thalamus-MD_rh"]; 

all_subjects = [subj_id];
use_cross_corr = 1;
strio_filename = "striosome_projection_rankings_v1.xlsx";
regions_to_load = [all_regions; dms_name];

[processed_activities, cross_corrs, strio_projecting_regions, matrix_projecting_regions, brain_region_names, voxel_ref, rankings] = ...
    process_input_data(voxel_dir, all_subjects, use_cross_corr, dms_name, strio_filename, regions_to_load);

% first level of fuzzy logic on all regions
regions_to_hotspot = ["Hb_mni" ; "a24_a32_lh"; "a24_a32_rh"];
%[striosomalities] = apply_fuzzy_logic(cross_corrs, voxel_ref, dms_name, brain_region_names, all_regions,...
% regions_to_hotspot, rankings, h, thresh);
%save(save_to + "/" + dms_name + "_striosomalities_fis_" + string(thresh) + "_thresh.mat","striosomalities")
load(save_to + "/" + dms_name + .mat")

% second level of fuzzy logic on input regions
%combined_strio_list = combine_rois_fuzzy_logic(striosomalities, all_regions, dms_name, rankings);
%save(save_to + "/" + dms_name + "_combined_list_fis_" + string(thresh) + "_thresh.mat","combined_strio_list")
load(save_to + "/" + dms_name + "_combined_list_fis.mat")

% combining input + output regions 
lh_index = find(all_regions=="Hb_mni");
sn_index = find(all_regions=="final_SN");
lh_striosomality = striosomalities(lh_index, :);
sn_striosomality = striosomalities(sn_index, :);
downstream_striosomalities = [lh_striosomality; sn_striosomality];

[upstream_list, downstream_list, both_list, up_and_lh, up_and_sn] = combine_upstream_downstream_fuzzy_logic(combined_strio_list, downstream_striosomalities); 
matrix  = ((downstream_list == 0) & (upstream_list == 0));

sn_list = sn_striosomality > 0;
lh_list = lh_striosomality > 0;

% exporting strio / striatum mask
create_mask_helper(all_subjects, brain_region_names, voxel_ref, upstream_list, char(mask_dir + "/" + dms_name + "_upstream_striosome_" + thresh +"_thresh.nii"), dms_name, dms_mask_filename)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, downstream_list, char(mask_dir + "/" + dms_name + "_downstream_striosome_" + thresh +"_thresh.nii"), dms_name, dms_mask_filename)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, both_list, char(mask_dir + "/" + dms_name + "_full_striosome_" + thresh +"_thresh.nii"), dms_name, dms_mask_filename)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, sn_list, char(mask_dir + "/" + dms_name + "_snc_striosome_" + thresh +"_thresh.nii"), dms_name, dms_mask_filename)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, lh_list, char(mask_dir + "/" + dms_name + "_lh_striosome_" + thresh +"_thresh.nii"), dms_name, dms_mask_filename)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, up_and_lh, char(mask_dir + "/" + dms_name + "_ups_lh_striosome_" + thresh +"_thresh.nii"), dms_name, dms_mask_filename)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, up_and_sn, char(mask_dir + "/" + dms_name + "_ups_snc_striosome_" + thresh +"_thresh.nii"), dms_name, dms_mask_filename)


end