%% at rest

all_subjects = ["547"];
speedrun = true;
use_cross_corr = 1;
strio_filename = "striosome_projection_rankings_v1.xlsx";

[processed_activities, cross_corrs, strio_projecting_regions, matrix_projecting_regions, brain_region_names, voxel_ref] = ...
    process_input_data(all_subjects, use_cross_corr, strio_filename);

 %% histograms showing vox data at rest

%quick_corr_histogram(cross_corrs, brain_region_names, "rest")

%% getting thresholds

min_sttm = 0.10;
max_sttm = 0.2;
valid_combos = find_entropy_thresholds(all_subjects, brain_region_names, cross_corrs, voxel_ref, min_sttm, max_sttm);

top_n = 1;
compare_rois = ["Amygdala-LB.Bl", "Hb_mni", "Thalamus-MD", "pOFC_v2"];
avg_thresholds = get_avg_threshold_from_table(brain_region_names, compare_rois, valid_combos, top_n);

%%
% group striatal vox based on thresholds 

[all_labels, all_striosomalities, hi_projecting_vox, striatum_vox, corr_thresholds] = ...
     threshold_strio_vox(all_subjects, cross_corrs, avg_thresholds, brain_region_names, voxel_ref);

% volume viewer - at rest

br_names = brain_region_names{1,1};
compare_rois = ["Amygdala-LB.Bl", "Hb_mni", "Thalamus-MD", "pOFC_v2"];
is_mem = ismember(br_names, compare_rois);
br_ids = find(is_mem);

for i = 1:length(br_ids)
    id = br_ids(i);
    base_roi_name = br_names(id);
    base_roi_name
    volumeViewer(all_striosomalities{id}{1,1},all_labels{id}{1,1})
end
