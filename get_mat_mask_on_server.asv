function get_mat_mask_on_server(subj_id, dms_name)

subj_dir = "/sc/arion/projects/K01_VTA/users/rakocl01/" + subj_id + "/test";
voxel_dir = subj_dir + "/voxel_dir";
mask_dir = subj_dir + "/ROIs/native";

save_to = subj_dir + "results/";
mkdir(save_to)
all_regions = ["Area-3a_rh_MNI152"; "Area-3a_lh_MNI152"; "Area-4p_rh_MNI152"; "Area-4p_lh_MNI152"];

all_subjects = [subj_id];
use_cross_corr = 1;
strio_filename = "striosome_projection_rankings_v1.xlsx";
regions_to_load = [all_regions; dms_name];

[processed_activities, cross_corrs, strio_projecting_regions, matrix_projecting_regions, brain_region_names, voxel_ref, rankings] = ...
    process_input_data(voxel_dir, all_subjects, use_cross_corr, dms_name, strio_filename, regions_to_load);

% first level of fuzzy logic on all regions
regions_to_hotspot = [];
[striosomalities] = apply_fuzzy_logic(cross_corrs, voxel_ref, dms_name, brain_region_names, all_regions,...
    regions_to_hotspot, rankings);
save(save_to + "/matrisomalities_newfis.mat","matriosomalities")
%load(save_to + "/matrisomalities_newfis.mat")

% second level of fuzzy logic on input regions
combined_strio_list = combine_rois_fuzzy_logic(striosomalities, all_regions, dms_name, rankings);
save(save_to + "/combined_mat_list_newfis.mat","combined_mat_list")
%load(save_to + "/combined_mat_list_newfis.mat")

% combining input + output regions 
lh_index = find(all_regions=="Hb_mni");
sn_index = find(all_regions=="final_SN");
lh_striosomality = striosomalities(lh_index, :);
sn_striosomality = striosomalities(sn_index, :);
downstream_striosomalities = [lh_striosomality; sn_striosomality];

[upstream_list, downstream_list, both_list] = combine_upstream_downstream_fuzzy_logic(combined_strio_list, downstream_striosomalities); 
matrix  = ((downstream_list == 0) & (upstream_list == 0));

% exporting strio / striatum mask
create_mask_helper(all_subjects, brain_region_names, voxel_ref, upstream_list, char(mask_dir + "/" + dms_name + "_upstream_striosome.nii"), dms_name)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, downstream_list, char(mask_dir + "/" + dms_name + "_downstream_striosome.nii"), dms_name)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, both_list, char(mask_dir + "/" + dms_name + "_full_striosome.nii"), dms_name)
create_mask_helper(all_subjects, brain_region_names, voxel_ref, matrix, char(mask_dir + "/" + dms_name + "_full_matrix.nii"), dms_name)

end